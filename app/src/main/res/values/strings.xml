    <string name="pair_title">Pair a PS5</string>
    <string name="pair_step1">On the PS5, open Settings › System › Remote Play and turn on Enable Remote Play.</string>
    <string name="pair_step2">Choose Link Device. The PS5 shows an 8-digit code.</string>
    <string name="pair_step3">Sign in with the same PlayStation account as on the PS5 and enter the code.</string>
