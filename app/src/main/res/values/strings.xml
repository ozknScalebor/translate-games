    <!-- AI translation -->
    <string name="ai_title">AI translation (offline)</string>
    <string name="ai_desc">Translates with Gemma 4, a language model running on this tablet: more natural phrasing, fixes leftover OCR mistakes and keeps names and tone consistent across lines. Each line appears once, complete, when the model has finished; the regular translator is only used if the AI fails. No internet, tokens or costs.</string>
